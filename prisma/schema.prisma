generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ActivityType {
  WORDLE
  WORD_SEARCH
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model Activity {
  id          Int          @id @default(autoincrement())
  title       String
  activityType ActivityType
  difficulty  Difficulty
  hint        String?
  gridSize    Int          @default(12)
  maxAttempts Int          @default(6)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  source      DataSource @default(LIVE)
  events      OperationEvent[]
  words       Word[]
}

model Word {
  id         Int      @id @default(autoincrement())
  text       String
  phonemes   String
  hint       String?
  activityId Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([activityId, text])
}


enum DataSource {
  LIVE
  SIMULATED
}

enum EventType {
  ACTIVITY_CREATED
  GENERATION
}

enum Outcome {
  SUCCESS
  FAILURE
}

model OperationEvent {
  id            Int @id @default(autoincrement())
  eventKey      String @unique
  eventType     EventType
  outcome       Outcome
  activityId    Int?
  activityTitle String
  activityType  ActivityType
  source        DataSource @default(LIVE)
  errorCategory String?
  errorMessage  String?
  durationMs    Int @default(0)
  occurredAt    DateTime @default(now())
  activity      Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  @@index([source, occurredAt])
}

model PageVisit {
  id                Int @id @default(autoincrement())
  visitKey          String @unique
  path              String
  visibleDurationMs Int
  source            DataSource @default(LIVE)
  occurredAt        DateTime @default(now())

  @@index([source, occurredAt])
}
